+def frs_rescore(torch, dev, maps, cov, d, TD, obs, dts, wsel, gid, K, TF0_t, x0, y0, PIX, SP, dv, px, py, vx, vy,
+                npos_min=3, pen=3.0, chunk=1024):
+    """gen 106 (arm A): robust re-score of fstk hypotheses on the 1" maps.  For each hypothesis (d-frame position px,py
+    at tref and velocity vx,vy, SP units) a 3x3 position (+-0.5 SP) x 3x3 velocity (+-0.5 dv SP) sub-grid is evaluated at
+    the exact per-exposure predicted pixel (nearest); per-night weighted sums give score = leave-max-night-out weighted
+    S/N, minus pen if fewer than npos_min nights have positive flux.  Returns (score, px, py, vx, vy) of the best
+    sub-grid point per hypothesis."""
+    N, H, W = maps.shape
+    chunk = max(32, min(chunk, int(3e6 / (81 * max(N, 1)))))
+    f32 = torch.float32
+    TDt = torch.tensor(np.asarray(TD), dtype=f32, device=dev)
+    ob = torch.tensor(np.asarray(obs, float), dtype=f32, device=dev)        # (N,3)
+    dt_ = torch.tensor(np.asarray(dts, float), dtype=f32, device=dev)       # (N,)
+    w_ = torch.ones(N, dtype=f32, device=dev) if wsel is None else torch.tensor(np.asarray(wsel, float), dtype=f32, device=dev)
+    G = torch.zeros((N, K), dtype=f32, device=dev)
+    G[torch.arange(N, device=dev), torch.tensor(np.asarray(gid), dtype=torch.int64, device=dev)] = 1.0
+    o3 = torch.tensor([-0.5, 0.0, 0.5], dtype=f32, device=dev)
+    dpx = (o3[:, None, None, None] * SP).expand(3, 3, 3, 3).reshape(-1)
+    dpy = (o3[None, :, None, None] * SP).expand(3, 3, 3, 3).reshape(-1)
+    dvx = (o3[None, None, :, None] * dv * SP).expand(3, 3, 3, 3).reshape(-1)
+    dvy = (o3[None, None, None, :] * dv * SP).expand(3, 3, 3, 3).reshape(-1)
+    mflat = maps.reshape(-1)
+    cflat = cov.reshape(-1) if cov is not None else None
+    nb = torch.arange(N, device=dev, dtype=torch.int64) * (H * W)
+    out_s, out_c = [], []
+    for j0 in range(0, len(px), chunk):
+        sl = slice(j0, j0 + chunk)
+        P_ = lambda a: torch.tensor(np.asarray(a[sl], float), dtype=f32, device=dev)
+        PX = P_(px)[:, None] + dpx[None]; PY = P_(py)[:, None] + dpy[None]         # (B,C)
+        VXt = P_(vx)[:, None] + dvx[None]; VYt = P_(vy)[:, None] + dvy[None]
+        gx = PX[..., None] + VXt[..., None] * dt_; gy = PY[..., None] + VYt[..., None] * dt_   # (B,C,N)
+        Wd = TDt[2] + gx[..., None] * TDt[0] + gy[..., None] * TDt[1]
+        Wd = Wd / torch.linalg.norm(Wd, dim=-1, keepdim=True)
+        X = d * Wd - ob
+        q = X @ TF0_t.T
+        ix = torch.round((q[..., 0] / q[..., 2] - x0) / PIX).to(torch.int64)
+        iy = torch.round((q[..., 1] / q[..., 2] - y0) / PIX).to(torch.int64)
+        del Wd, X, q, gx, gy
+        ok = (ix >= 0) & (ix < W) & (iy >= 0) & (iy < H)
+        lin = torch.where(ok, iy * W + ix, torch.zeros_like(ix)) + nb
+        v = mflat[lin].float()
+        c = ok if cflat is None else (ok & cflat[lin])
+        if cflat is None:
+            c = c & (v != 0)
+        cf = c.float()
+        v = v * cf
+        Sn = (v * w_) @ G                       # (B,C,K)
+        Wn = (cf * w_ * w_) @ G
+        zn = torch.where(Wn > 0, Sn / torch.sqrt(Wn.clamp(min=1e-6)), torch.full_like(Sn, -1e9))
+        im = zn.argmax(-1, keepdim=True)
+        St = Sn.sum(-1) - Sn.gather(-1, im)[..., 0]
+        Wt = Wn.sum(-1) - Wn.gather(-1, im)[..., 0]
+        s = St / torch.sqrt(Wt.clamp(min=1e-3))
+        npos = ((Wn > 0) & (Sn > 0)).sum(-1)
+        s = torch.where(npos >= npos_min, s, s - pen)
+        bs, bi = s.max(1)
+        out_s.append(bs); out_c.append(bi)
+        del v, c, cf, Sn, Wn, zn, lin, ix, iy, ok
+    sc = torch.cat(out_s).cpu().numpy().astype(float)
+    bi = torch.cat(out_c).cpu().numpy()
+    dpx, dpy, dvx, dvy = (a.cpu().numpy().astype(float) for a in (dpx, dpy, dvx, dvy))
+    return (sc, np.asarray(px, float) + dpx[bi], np.asarray(py, float) + dpy[bi],
+            np.asarray(vx, float) + dvx[bi], np.asarray(vy, float) + dvy[bi])
