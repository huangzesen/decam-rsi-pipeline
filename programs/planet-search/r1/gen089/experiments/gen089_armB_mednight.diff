+def chi_stats(v, c, wf, nights_idx):
+    """gen 89 (TNO_RANKX_CHI): per-exposure consistency of a track.  Model z_i = F * wf_i (wf = expected S/N of a
+    fixed-magnitude source per exposure); F fitted by weighted least squares over covered exposures.
+    Returns (b, X): b = weighted stack S/N with the single largest-contributing NIGHT dropped (robust significance);
+    X = (chi2 - dof) / sqrt(2 dof) of residuals v_i - F wf_i (excess scatter, ~N(0,1) for consistent tracks)."""
+    v = np.where(c, v, 0.0).astype(np.float64)
+    cw = c.astype(np.float64)
+    num = v * wf[None]; den = cw * (wf ** 2)[None]
+    Nt = num.sum(1); Dt = den.sum(1)
+    F = Nt / np.maximum(Dt, 1e-6)
+    r = (v - F[:, None] * wf[None]) * cw
+    n = cw.sum(1)
+    dof = np.maximum(n - 1, 1)
+    X = ((r ** 2).sum(1) - dof) / np.sqrt(2 * dof)
+    nk = np.stack([num[:, idx].sum(1) for idx in nights_idx], 1)
+    dk = np.stack([den[:, idx].sum(1) for idx in nights_idx], 1)
+    kb = np.argmax(nk, 1); ar = np.arange(len(v))
+    b = (Nt - nk[ar, kb]) / np.sqrt(np.maximum(Dt - dk[ar, kb], 1e-3))
+    ncov = (dk > 0).sum(1)
+    b = np.where(ncov >= 3, b, -9.0)
+    X = np.where(n >= 3, X, 0.0)
+    return b, X
+
+
+def mednight_stat(v, c, wf, nights_idx):
+    """gen 89 (TNO_RANKX_CHI mode 'mednight'): robust per-night consistency.  Per covered night k the depth-weighted
+    flux F_k = sum(v w) / sum(w^2); the statistic is MEDIAN_k(F_k) * sqrt(sum over all covered exposures of w^2), i.e.
+    the all-exposure stack S/N a body with the median night's flux would have.  One or two bright nights (cosmic,
+    artefact, local noise excursion) cannot raise it; a real body (flux on every night) keeps ~its full stack S/N."""
+    v = np.where(c, v, 0.0).astype(np.float64)
+    num = v * wf[None]; den = c * (wf ** 2)[None]
+    Fk = np.stack([np.where(den[:, i].sum(1) > 0, num[:, i].sum(1) / np.maximum(den[:, i].sum(1), 1e-6), np.nan)
+                   for i in nights_idx], 1)
+    ncov = np.isfinite(Fk).sum(1)
+    med = np.array([np.median(r[np.isfinite(r)]) if np.isfinite(r).any() else 0.0 for r in Fk])
+    return np.where(ncov >= 3, med * np.sqrt(den.sum(1)), -9.0)
+
