+def _natwide(torch, dev, maps, obs, dts, wsel, DW, d, TD, TF0, x0, y0, PIX, SP, WD, HD, P, xx, yy, ex_, ey_, evx_, evy_,
+             VX, VY, hh, s2_, on_, N, dv, clip, mu, NATWN, NATWC, NATWX, log, dd, sc_co=None):
+    """gen 140 (TNO_FSTK_NATW): returns the widened native pool (indices into the slice's coarse peak list).  on_ = gen139's
+    pool (kept, first).  Pre-pass pool: best NATWN by clip-3 score s2_ UNION best NATWC by coarse rank (the coarse peak list
+    is topk-sorted, so index = coarse rank), minus on_; each scored on the 1" maps over a cheap grid (position +-0.5 cell,
+    velocity +-1 dv, 0.5 steps); the best NATWX of them are appended to on_."""
+    sh = 24.0 / max(N, 24)
+    nw = int(NATWN * sh); nc = int(NATWC * sh); nx = int(NATWX * sh)
+    n = len(s2_)
+    if nx <= 0 or (nw <= 0 and nc <= 0) or n <= len(on_):
+        return on_
+    okk = s2_ > -1e8
+    cand = np.zeros(n, bool)
+    if nw > 0:
+        cand[np.argsort(-s2_)[:nw]] = True
+    if nc > 0:
+        # coarse-score order (the coarse list is topk-sorted only when it was longer than NPK_; else raster order)
+        if sc_co is not None and len(sc_co) == n:
+            cand[np.argsort(-np.asarray(sc_co))[:nc]] = True
+        else:
+            cand[:min(nc, n)] = True
+    cand &= okk
+    cand[on_] = False
+    ci = np.nonzero(cand)[0]
+    if len(ci) == 0:
+        return on_
+    gp = np.array([-0.5, 0.0, 0.5]); gv = np.array([-1.0, -0.5, 0.0, 0.5, 1.0]) * dv
+    b, _, _, _, _ = _natgrid(torch, dev, maps, obs, dts, wsel, DW, d, TD, TF0, x0, y0, PIX, SP, WD, HD, P,
+                             xx[ci] + ex_[ci], yy[ci] + ey_[ci], VX[hh[ci]] + evx_[ci], VY[hh[ci]] + evy_[ci], clip, mu, gp, gv)
+    b = np.where(np.isfinite(b) & (b < 1e3), b, -1e9)
+    o = np.argsort(-b)[:nx]
+    o = o[b[o] > -1e8]
+    add = ci[o]
+    try:
+        # diagnostic: how many added peaks came from beyond the clip-3 pool cut / from the coarse-only part
+        rk = np.empty(n, np.int64); rk[np.argsort(-s2_)] = np.arange(n)
+        log(f"fstk natwide d={dd:.2f}: pre-pass {len(ci)} peaks, added {len(add)}, of which clip3-rank>{nw} (coarse-only) "
+            f"{int((rk[add] >= nw).sum())}, pre max {b.max():.2f}, add min {b[o].min() if len(o) else 0:.2f}")
+    except Exception:
+        pass
+    return np.concatenate([np.asarray(on_, np.int64), add.astype(np.int64)])
