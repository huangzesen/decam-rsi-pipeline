+def _cstat(torch, D, mode, Wk, log=None, what=""):
+    """gen 115 (arm L): transform the (median-subtracted) co-adds D (K, H, W) in place into per-co-add score terms
+    whose plain sum is the stack score (returns the norm to apply: 1.0).  Uncovered pixels (exact 0) stay 0.
+    z_k = D_k / (1.4826 MAD_k) on covered px; a_k = sqrt(W_k / sum W) (depth share of a body's S/N^2);
+    mad: a_k z_k;  cclip: a_k clip(z_k, +-CCLIP);  llr: [g_k(z_k) + mu_k^2/2] / S, mu_k = S a_k,
+    g_k(z) = log((1-e) N(z - mu_k) + e U) - log((1-e) N(z) + e U)  (linear mu z - mu^2/2 in the core, bounded)."""
+    K = D.shape[0]
+    a = np.sqrt(np.asarray(Wk, float) / max(float(np.sum(Wk)), 1e-12))
+    CC = float(os.environ.get("TNO_FSTK_CCLIP", "3.0"))
+    S = float(os.environ.get("TNO_FSTK_LSIG", "6.0"))
+    e = float(os.environ.get("TNO_FSTK_LEPS", "0.01"))
+    U = float(os.environ.get("TNO_FSTK_LU", "0.05"))
+    sig = []
+    for k in range(K):
+        v_ = D[k, ::3, ::3].float(); v_ = v_[v_ != 0]
+        s_ = float(1.4826 * torch.median(v_.abs())) if v_.numel() > 100 else 1.0
+        s_ = s_ if s_ > 1e-6 else 1.0
+        sig.append(s_)
+        del v_
+        for y0 in range(0, D.shape[1], 2048):
+            x = D[k, y0:y0 + 2048].float()
+            cov = x != 0
+            z = x / s_
+            if mode == "mad":
+                h = a[k] * z
+            elif mode == "cclip":
+                h = a[k] * z.clamp(-CC, CC)
+            else:
+                mu = S * a[k]
+                c0 = math.log(1 - e) - 0.5 * math.log(2 * math.pi)
+                l1 = torch.logaddexp(c0 - 0.5 * (z - mu) ** 2, torch.full_like(z, math.log(e * U)))
+                l0 = torch.logaddexp(c0 - 0.5 * z ** 2, torch.full_like(z, math.log(e * U)))
+                h = (l1 - l0 + 0.5 * mu * mu) / S
