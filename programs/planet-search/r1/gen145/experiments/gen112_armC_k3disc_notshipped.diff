+    out = {}
+    out["zc"] = zn(stk(vc, c))
+    out["zu"] = zn(stk(vv, c))
+    un = np.unique(night); par = np.isin(night, un[::2]).astype(float)
+    a, b_ = stk(vc, c, par), stk(vc, c, 1 - par)
+    out["alt"] = zn(np.minimum(a, b_) * math.sqrt(2))
+    tq = np.zeros(len(night)); tq[len(night) // 2:] = 1  # stackd frames are time-ordered?
+    a2, b2 = stk(vc, c, 1 - tq), stk(vc, c, tq)
+    out["half"] = zn(np.minimum(a2, b2) * math.sqrt(2))
+    # per-night flux chi2
+    F, W_ = [], []
+    for u_ in un:
+        idx = night == u_
+        num = (vc[:, idx] * wf[idx][None]).sum(1); den = (c[:, idx] * wf[idx][None] ** 2).sum(1)
+        F.append(np.where(den > 0, num / np.maximum(den, 1e-9), 0)); W_.append(den)
+    F, W_ = np.stack(F, 1), np.stack(W_, 1)
+    fb = (F * W_).sum(1) / np.maximum(W_.sum(1), 1e-9)
+    ncv = (W_ > 0).sum(1)
