+        st["moff"] = -np.nanmean(offs, 1)
+        st["conc"] = np.nanmedian(conc, 1)
+    # full-stack patch: shape
+    num = (pt * wf[None, :, None, None]).sum(1); den = (pc * wf[None, :, None, None] ** 2).sum(1)
