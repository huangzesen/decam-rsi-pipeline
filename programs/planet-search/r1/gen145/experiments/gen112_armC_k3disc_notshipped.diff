+"""emu.py SDDIR OUT.json NEW.json [K3DZ K3DC K3DB]: offline emulation of TNO_K3DISC on a stackd output."""
+import sys, json, math, numpy as np
+sd, so, sn = sys.argv[1:4]; ZT, CT, B = (float(x) for x in (sys.argv[4:7] if len(sys.argv) > 6 else (3.3, 2.5, 1.0)))
+D = np.load(sd + "/disc_stats.npz"); ref = json.load(open(sd + "/refined.json"))["candidates"]
+S = np.array([r["state"] for r in ref])
+cs = json.load(open(so))["candidates"]; n = 0
+for c in cs:
+    if "zc" not in c or c["zc"] < ZT: continue
+    j = int(np.argmin(np.linalg.norm(S[:, :3] - np.array(c["state"][:3])[None], axis=1)))
+    if D["conc"][j] >= CT:
+        z = c["zc"] + B; c["p"] = max(c["p"], 1 / (1 + math.exp(-(z - 4.5) / 0.8))); n += 1
+print("boosted", n)
+json.dump({"candidates": sorted(cs, key=lambda c: -c["p"])}, open(sn, "w"))
