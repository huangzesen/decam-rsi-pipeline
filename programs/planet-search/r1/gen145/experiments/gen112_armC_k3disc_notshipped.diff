+keys = [k for k in st if k not in ("ncv",)]
+# for each matched body (best zc track per body among kind-3), number of junk competitors above it under each stat
+bodies = {}
+for k in np.flatnonzero(k3 & (match >= 0)):
+    if mcls[k][0] == "A": continue
+    if mcls[k] not in bodies or st["zc"][k] > st["zc"][bodies[mcls[k]]]: bodies[mcls[k]] = k
+print("stat:", " ".join(f"{k:>7s}" for k in keys))
+for nm, k in sorted(bodies.items()):
+    print(f"{nm:5s} zc {st['zc'][k]:5.2f} vals", " ".join(f"{st[q][k]:7.2f}" for q in keys))
+    print("      junk-above", " ".join(f"{int((st[q][comp] >= st[q][k]).sum()):7d}" for q in keys))
