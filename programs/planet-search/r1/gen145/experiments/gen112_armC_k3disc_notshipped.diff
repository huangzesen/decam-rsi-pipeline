+rng = np.random.default_rng(0)
+base = np.flatnonzero((rkd == 2) & (st["ncv"] >= 4))
+base = rng.choice(base, min(1500, len(base)), replace=False)
+pos_all = {}
+FREEZE[0] = True
+for T in (2.5, 3.0, 3.5, 4.0):
+    vb, cb = v[base].copy(), c[base]
+    s = T / np.sqrt(np.maximum((cb * wf[None] ** 2).sum(1), 1e-3))
