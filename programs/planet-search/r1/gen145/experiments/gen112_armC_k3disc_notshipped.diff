+    return (vv * w).sum(1) / np.sqrt(np.maximum((cc * w * wf[None]).sum(1), 1e-3))
+NREF = {}
+_cnt = [0]
+def zn(x):
+    _cnt[0] += 1; key = _cnt[0] % 1000
+    if FREEZE[0]:
+        m, s = NREF[key]
+    else:
+        nul = x[rkd == 2]; m = np.median(nul); s = 1.4826 * np.median(np.abs(nul - m)) + 1e-3; NREF[key] = (m, s)
+    return (x - m) / s
+FREEZE = [False]
+def stats(v, c):
+    _cnt[0] = 0
