+    sep = np.arccos(np.clip((D[:, e] * u[e][None]).sum(-1), -1, 1)) / ARC
+    for k in np.flatnonzero((sep < 2).any(1)):
+        nn = len(set(nts[e[sep[k] < 2]].tolist()))
