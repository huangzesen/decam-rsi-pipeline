+import sys, json, csv, numpy as np
+sys.path.insert(0, "$RSI_SANDBOX/r1/gen112/tmp/exp"); sys.argv, a = ['x'], sys.argv
+import score_inject as si
+sd, so, tr, ex = a[1:5]
+D = np.load(sd + "/disc_stats.npz"); ref = json.load(open(sd + "/refined.json"))["candidates"]
+S = np.array([r["state"] for r in ref])
+truth = json.load(open(tr)); rows = list(csv.DictReader(open(ex)))
+cands = json.load(open(so))["candidates"]
+cs, res, hr, dup = si.score(truth, cands, rows)
+keys = [k for k in D.files if k not in ("match", "ncv")]
+print("rank    p   body  dist  " + " ".join(f"{k:>6s}" for k in keys))
+seen = set()
+for k, c in enumerate(cs[:120]):
+    if "zc" not in c: continue
+    j = int(np.argmin(np.linalg.norm(S[:, :3] - np.array(c["state"][:3])[None], axis=1)))
+    dd = float(np.linalg.norm(S[j, :3] - np.array(c["state"][:3])))
+    h = res[k]; b = truth["bodies"][h[0]]["cls"] + str(h[0]) if h else "-"
+    if b != "-" and b in seen: continue
+    seen.add(b)
+    print(f"{k:4d} {c['p']:.3f} {b:5s} {dd:.3f} zc={c['zc']:.2f} " + " ".join(f"{float(D[q][j]):6.2f}" for q in keys))
