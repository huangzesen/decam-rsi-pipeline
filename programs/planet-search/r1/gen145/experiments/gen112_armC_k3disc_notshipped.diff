+import sys, numpy as np, json
+sd = sys.argv[1]; ZT = float(sys.argv[2]) if len(sys.argv) > 2 else 2.5
+D = np.load(sd + "/disc_stats.npz"); z = np.load(sd + "/refined_vc.npz"); rkd = z["rkd"]
+truth = json.load(open("$RSI_SANDBOX/r1/gen112/tmp/inj7d/truth.json"))["bodies"]
+m = D["match"]; zc = D["zc"]; conc = D["conc"]; k3 = rkd == 3
+lab = np.array([truth[j]["cls"] + str(j) if j >= 0 else "-" for j in m])
+junk = k3 & (m < 0) & (zc >= ZT)
+print("junk n", junk.sum(), "conc quantiles", np.round(np.nanpercentile(conc[junk], [50, 90, 95, 99]), 2))
+for w in (0, 0.5, 1.0, 1.5, 2.0, 3.0):
+    sc = zc + w * np.nan_to_num(conc, nan=0)
+    best = {}
+    for k in np.flatnonzero(k3 & (m >= 0)):
+        if lab[k] not in best or sc[k] > sc[best[lab[k]]]: best[lab[k]] = k
+    s = " ".join(f"{b}:{int((sc[junk] >= sc[k]).sum())}" for b, k in sorted(best.items()) if b[0] != "A")
+    sa = sum(int((sc[junk] >= sc[k]).sum()) for b, k in best.items() if b[0] == "A")
+    print(f"w={w}: junk-above per B/C body: {s} | sum over A {sa}")
+# gate: conc threshold
+for ct in (2.0, 2.5, 2.8, 3.0):
+    print("conc>=", ct, "junk pass", int((junk & (conc >= ct)).sum()), "of", junk.sum(), " zc>=3.5 junk pass", int((junk & (zc >= 3.5) & (conc >= ct)).sum()),
+          " real pass:", sorted(set(lab[k3 & (m >= 0) & (conc >= ct)])))
