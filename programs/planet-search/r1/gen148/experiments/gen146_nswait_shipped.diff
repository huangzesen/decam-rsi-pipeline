+            try:
+                NSN_ = int(os.environ.get("TNO_NS_N", "0") or 0) or (8000 if cuda else 1500)
+                ns_dl_ = min(budget * float(os.environ.get("TNO_NS_DL", "0.80")),
+                             (time.time() - T0) + float(os.environ.get("TNO_NS_DLF", "0.15")) * budget)
+                ns_pre = night_seeds(torch, F, dev, maps, cov, wf, t, night, obs, TF0, x0, y0, PIX, W, H,
+                                     ns_dl_, NSN_, log)
+                log(f"conc: night seeds during linker wait: {len(ns_pre[0])} rows, {time.time() - T0:.0f}s elapsed")
+            except Exception as ex:
+                log("wait-time night seeds failed:", ex)
+                ns_pre = None
         while not os.path.exists(wf_) and time.time() - T0 < wdl_:
             time.sleep(0.5)
         log(f"conc: waited {time.time() - tw_:.0f}s for linker seeds ({'ready' if os.path.exists(wf_) else 'NOT ready'})")
