     if wf_:
         tw_ = time.time()
         wdl_ = budget * float(os.environ.get("TNO_SEEDS_WAITF", "0.80"))
+        # gen 146 (TNO_NS_WAIT, default 1; 0 = gen143): if the linker is not done yet, compute the night seeds NOW
