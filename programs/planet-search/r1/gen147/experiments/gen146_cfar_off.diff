+def _cfar(torch, F, bs, B):
+    """gen 146: locally standardised copy of the coarse canvas bs (H, W), uncovered (== 0) pixels left at 0.
+    Per B x B block: median and 1.4826 MAD of covered pixels (every 2nd column); blocks < 30 % covered use the
+    global values; local sigma >= 0.5 global.  z = (bs - med_loc) / sig_loc * sig_g + med_g (global scale kept)."""
+    H, W = bs.shape
+    Hp, Wp = -(-H // B) * B, -(-W // B) * B
+    x = F.pad(bs.float()[None, None], (0, Wp - W, 0, Hp - H))[0, 0]
+    nby, nbx = Hp // B, Wp // B
+    blk = x.reshape(nby, B, nbx, B).permute(0, 2, 1, 3).reshape(nby * nbx, B * B)[:, ::2]
+    cov = torch.isfinite(blk) & (blk != 0)
+    ncov = cov.sum(1)
+    big = torch.tensor(1e30, device=bs.device)
+    srt = torch.sort(torch.where(cov, blk, big), 1).values
+    mi = (ncov - 1).clamp(min=0) // 2
+    med = srt.gather(1, mi[:, None])[:, 0]
+    dev_ = torch.where(cov, (blk - med[:, None]).abs(), big)
+    sig = 1.4826 * torch.sort(dev_, 1).values.gather(1, mi[:, None])[:, 0]
+    v = bs[::3, ::3].float(); v = v[torch.isfinite(v) & (v != 0)]
+    if v.numel() < 100:
+        return bs
+    med_g = float(torch.median(v)); sig_g = max(1.4826 * float(torch.median((v - med_g).abs())), 1e-6)
+    if not (math.isfinite(med_g) and math.isfinite(sig_g)):
+        return bs
+    ok = ncov >= 0.3 * blk.shape[1]
+    med = torch.where(ok, med, torch.full_like(med, med_g))
+    sig = torch.where(ok, sig, torch.full_like(sig, sig_g)).clamp(min=0.5 * sig_g)
+    mg = F.interpolate(med.reshape(1, 1, nby, nbx), size=(Hp, Wp), mode="bilinear", align_corners=False)[0, 0, :H, :W]
+    sg = F.interpolate(sig.reshape(1, 1, nby, nbx), size=(Hp, Wp), mode="bilinear", align_corners=False)[0, 0, :H, :W]
+    bf = bs.float()
+    z = (bf - mg) / sg * sig_g + med_g
+    return torch.where(bf != 0, z, bf)
+
