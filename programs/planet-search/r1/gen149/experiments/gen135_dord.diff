+# gen 135 (TNO_DORD_K, default 1.6; 1 = gen134): distance-slice priority for deadline-bound searches.  Was symmetric in
+# log(d/42); real TNOs (and the bright, findable ones even more: flux ~ d^-4) sit inside ~48 au (the Kuiper cliff), and
+# plutinos at 30-36 au are ~1 mag brighter than classicals, so slices beyond 42 au are pushed back by a factor K.
+# Order only: identical results whenever every slice is searched (except pstk / night seeds, whose running best-dict
+# pruning depends on visit order, marginal keys only).
+def _dkey(d):
+    try:
+        K_ = float(os.environ.get("TNO_DORD_K", "1.6"))
+    except Exception:
+        K_ = 1.6
+    if not (K_ > 0):
+        K_ = 1.6
+    return math.log(42.0 / d) if d <= 42.0 else K_ * math.log(d / 42.0)
+
