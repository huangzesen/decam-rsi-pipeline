>         base = np.array([1.5 * ARCR, 1.5 * ARCR, 0.6 * dv * SP, 0.6 * dv * SP, 0.03])
>         sig = base[None] * r[:, None]
>         mu = np.zeros((B_, 5))
>         bestS = S0.copy(); bestv = np.full(B_, -1e9)
>         ne = max(8, K_ // 16)
>         ar = np.arange(B_)
>         for itn in range(iters):
>             Z = mu[:, None] + rng.standard_normal((B_, K_, 5)) * sig[:, None]
>             Z[:, 0] = mu
>             S = np.repeat(S0[:, None], K_, 1)                            # (B,K,6)
>             S[..., :3] += Z[..., 0:1] * TL[:, None, 0] + Z[..., 1:2] * TL[:, None, 1]
>             los = S[..., :3] - oref; losn = los / np.linalg.norm(los, axis=-1, keepdims=True)
>             S[..., :3] += Z[..., 4:5] * losn
>             S[..., 3:] += Z[..., 2:3] * TL[:, None, 0] + Z[..., 3:4] * TL[:, None, 1]
>             v, c = score_states(S.reshape(-1, 6))
>             tot = total(v, c).reshape(B_, K_)
>             el = np.argsort(-tot, 1)[:, :ne]
