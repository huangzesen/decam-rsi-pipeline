+def _ns_junk_masks(torch, F, dev, maps, cov, wf, nidx, H, W, deadline, jm_log):
+    """gen 88: per-night junk-area masks (float32 (H, W) 0/1 tensors or None) from the plain night co-adds."""
+    JC = max(8, int(os.environ.get("TNO_NS_JC", "32")))
+    JZF = float(os.environ.get("TNO_NS_JZF", "0.9"))
+    JK = float(os.environ.get("TNO_NS_JK", "5.0"))
+    JFMIN = float(os.environ.get("TNO_NS_JFMIN", "0.02"))
+    JMAXF = float(os.environ.get("TNO_NS_JMAXF", "0.85"))   # never mask more than this fraction of a night's area
+    fr = []
+    for idx in nidx:
+        acc = torch.zeros((H, W), dtype=torch.float32, device=dev)
+        cw = torch.zeros((H, W), dtype=torch.float32, device=dev)
+        for n in idx:
+            acc += maps[n].float() * float(wf[n]); cw += cov[n].float() * float(wf[n] ** 2)
+        z_ = torch.where(cw > 0, acc / torch.sqrt(torch.clamp(cw, min=1e-3)), torch.zeros_like(acc))
+        del acc, cw
+        wk_ = np.asarray(wf[idx], float)
+        zc_ = 5.0 * wk_.sum() / math.sqrt(max((wk_ ** 2).sum(), 1e-9))
+        lit = (z_ >= JZF * zc_).float()
+        del z_
+        f_ = F.avg_pool2d(lit[None, None], JC, JC, 0, ceil_mode=True, count_include_pad=False)[0, 0]
+        fr.append(f_.cpu().numpy().astype(np.float64))
+        del lit
+        if time.time() - T0 > deadline:
+            raise RuntimeError("deadline")
+    allf = np.concatenate([f.ravel() for f in fr])
+    med = float(np.median(allf)); mad = float(np.median(np.abs(allf - med))) * 1.4826
+    thr = max(JFMIN, med + JK * mad)
+    jm_log.append(f"cell {JC} px, lit z >= {JZF} x ceiling, pooled median {med:.4f} mad {mad:.4f} -> thr {thr:.4f}")
+    out = []
+    for f in fr:
+        bad = f > thr
+        if bad.mean() > JMAXF:
+            # keep the least-lit cells unmasked
+            q = np.quantile(f, JMAXF); bad = f > max(q, thr)
+        if not bad.any():
+            out.append(None); jm_log.append((0, int(bad.size), 0)); continue
+        m = torch.from_numpy((~bad).astype(np.float32)).to(dev)
+        m = m.repeat_interleave(JC, 0).repeat_interleave(JC, 1)[:H, :W].contiguous()
+        out.append(m)
+        jm_log.append((int(bad.sum()), int(bad.size), int((m == 0).sum().item())))
+    return out
+
