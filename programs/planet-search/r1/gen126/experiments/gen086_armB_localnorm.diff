+        mi_ = torch.clamp(ncv // 2, max=LNRT * LNRT - 1)
+        med = srt.gather(1, mi_[:, None])
+        dev_ = torch.abs(tl - torch.where(torch.isfinite(med), med, torch.zeros_like(med)))
+        dev_ = torch.where(torch.isfinite(tl), dev_, torch.full_like(dev_, inf_))
+        del srt
+        mad = torch.sort(dev_, 1).values.gather(1, mi_[:, None])[:, 0] * 1.4826
+        del dev_, tl
+        ok_ = (ncv >= LNRMIN) & torch.isfinite(mad) & (mad > 0)
+        if int(ok_.sum()) < 4:
+            return None, None
+        ref = torch.median(mad[ok_])
+        sc_ = torch.where(ok_, mad / torch.clamp(ref, min=1e-6), torch.ones_like(mad))
+        sc_ = torch.clamp(sc_, min=1.0)
+        frac = float((sc_[ok_] > 1.2).float().mean())
+        up = F.interpolate(sc_.reshape(1, 1, nty_, ntx_), size=(Hp, Wp), mode="bilinear", align_corners=False)[0, 0]
+        up = torch.clamp(up[:H, :W], min=1.0)
+        lnr_t[0] += time.time() - t0_
+        return up, (round(frac, 3), round(float(sc_.max()), 2), round(float(ref), 2))
