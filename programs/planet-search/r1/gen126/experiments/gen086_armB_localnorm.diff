+    def lnr_scale(z, cw):
+        t0_ = time.time()
+        nty_ = -(-H // LNRT); ntx_ = -(-W // LNRT); Hp, Wp = nty_ * LNRT, ntx_ * LNRT
+        inf_ = float("inf")
+        zz = torch.full((Hp, Wp), inf_, dtype=torch.float32, device=z.device)
+        zz[:H, :W] = torch.where(cw > 0, z, torch.full_like(z, inf_))
+        tl = zz.reshape(nty_, LNRT, ntx_, LNRT).permute(0, 2, 1, 3).reshape(nty_ * ntx_, LNRT * LNRT)
+        del zz
+        ncv = torch.isfinite(tl).sum(1)
