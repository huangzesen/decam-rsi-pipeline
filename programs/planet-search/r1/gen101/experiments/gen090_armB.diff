+def _ns_resc(torch, dev, Ck, nN, tN, tref, TD, d, oN, TF0, x0, y0, PIX, W, H, NMs, gsel, m0s, s0s, RR=8, NR=16, CLH=4.0):
+    """gen 90 arm B (TNO_NS_RESC): local-contrast forced night evidence for night-seed rows.  For each candidate
+    (x, y, vx, vy at tref, d-frame) and each night, the (3x3 max-pooled) night co-add value v at the predicted pixel is
+    compared with NR samples on a ring of radius RR px around it: z' = (v - (m_ring - m0)) / max(1, s_ring / s0),
+    where m0, s0 are the median / MAD-sigma of the same map over random pixels (null calibration).  Clean sky gives
+    z' = v; dense junk / plateaus / star wings are suppressed.  Score = (sum clip(z', -2, CLH) - max) / sqrt(ncov - 1)
+    (leave-best-night-out).  Returns (score (K,), pix (K, nN, 2) int32)."""
+    K = len(Ck)
+    th = np.linspace(0, 2 * np.pi, NR, endpoint=False)
+    ox = torch.as_tensor(np.rint(RR * np.cos(th)).astype(np.int64), device=dev)
+    oy = torch.as_tensor(np.rint(RR * np.sin(th)).astype(np.int64), device=dev)
+    Z = torch.zeros((K, nN), dtype=torch.float32, device=dev); CV = torch.zeros((K, nN), dtype=torch.bool, device=dev)
+    PXY = np.zeros((K, nN, 2), np.int32)
+    for k in range(nN):
+        P = Ck[:, :2] + Ck[:, 2:] * (tN[k] - tref)
+        wv = TD[2][None] + P[:, 0:1] * TD[0][None] + P[:, 1:2] * TD[1][None]
+        X = d * wv / np.linalg.norm(wv, axis=1)[:, None] - oN[k][None]
+        q = X @ TF0.T
+        ix = np.rint((q[:, 0] / q[:, 2] - x0) / PIX).astype(np.int64)
+        iy = np.rint((q[:, 1] / q[:, 2] - y0) / PIX).astype(np.int64)
+        PXY[:, k, 0] = ix; PXY[:, k, 1] = iy
+        ok = (ix >= 0) & (ix < W) & (iy >= 0) & (iy < H)
+        ixt = torch.as_tensor(np.clip(ix, 0, W - 1), device=dev); iyt = torch.as_tensor(np.clip(iy, 0, H - 1), device=dev)
+        okt = torch.as_tensor(ok, device=dev)
+        M = NMs[gsel[k]]
+        v = M[iyt * W + ixt].float()
+        rx = (ixt[:, None] + ox[None]).clamp(0, W - 1); ry = (iyt[:, None] + oy[None]).clamp(0, H - 1)
+        ring = M[(ry * W + rx).reshape(-1)].float().reshape(K, NR)
+        m_ = ring.median(1).values
+        s_ = 1.4826 * (ring - m_[:, None]).abs().median(1).values
+        m0, s0 = m0s[gsel[k]], s0s[gsel[k]]
+        z = (v - (m_ - m0)) / torch.clamp(s_ / s0, min=1.0)
+        cv = okt & (v != 0)
+        Z[:, k] = torch.where(cv, z, torch.zeros_like(z)); CV[:, k] = cv
+    zc = torch.where(CV, Z.clamp(-2.0, CLH), torch.zeros_like(Z))
+    nc = CV.sum(1).float()
+    mx = torch.where(CV, zc, torch.full_like(zc, -9.0)).max(1).values
+    sc = (zc.sum(1) - mx) / torch.sqrt(torch.clamp(nc - 1, min=1.0))
+    return sc.cpu().numpy().astype(np.float64), PXY
+
