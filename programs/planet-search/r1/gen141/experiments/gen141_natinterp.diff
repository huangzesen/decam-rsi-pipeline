+def _nat_null(torch, dev, maps, clip, med, nsamp=40000, seed=141):
+    """gen 141 (TNO_FSTK_NATI): per-frame null of the bilinear sample, at random sub-pixel positions whose nearest cell is
+    covered (frames with < 500 such samples keep the gen140 median, scale 1).  Returns (mean of the bilinear sample, sd(nearest sample) / sd(bilinear sample)) per frame."""
+    N, H, W = maps.shape
+    rg = np.random.default_rng(seed)
+    mbl = np.array(med, float).copy(); scl = np.ones(N)
+    U = torch.tensor(rg.uniform(0, W - 1, nsamp), dtype=torch.float32, device=dev)
+    V = torch.tensor(rg.uniform(0, H - 1, nsamp), dtype=torch.float32, device=dev)
+    flat = maps.reshape(N, -1)
+    for k in range(N):
+        b_, okn, vn = _bilin(torch, flat[k], U, V, H, W, clip)
+        if int(okn.sum()) < 500:
+            continue
+        b_ = b_[okn]; vn = vn[okn]
+        sb = float(b_.std()); sn = float(vn.std())
+        mbl[k] = float(b_.mean())
+        if np.isfinite(sb) and np.isfinite(sn) and sb > 1e-3 and sn > 1e-3:
+            scl[k] = min(max(sn / sb, 0.5), 3.0)
+    return mbl, scl
+
