+def _bilin(torch, fk, U, V, H, W, clip):
+    """gen 141: bilinear sample of one frame's flat 1" map fk at float pixel coords (U, V) (any shape), over covered
+    (non-zero) corners with renormalised weights, values clipped at +-clip.  Returns (bilinear value, nearest-cell covered
+    mask, nearest-cell clipped value)."""
+    U0 = torch.floor(U); V0 = torch.floor(V)
+    fu = U - U0; fv = V - V0
+    num = torch.zeros_like(U); den = torch.zeros_like(U)
+    vn = torch.zeros_like(U); okn = torch.zeros(U.shape, dtype=torch.bool, device=U.device)
+    nu_ = fu >= 0.5; nv_ = fv >= 0.5
+    for a in (0, 1):
+        wa = fu if a else 1.0 - fu
+        cu = U0 + a
+        ia = (cu >= 0) & (cu <= W - 1)
+        for b in (0, 1):
+            wb = fv if b else 1.0 - fv
+            cv = V0 + b
+            ins = ia & (cv >= 0) & (cv <= H - 1)
+            idx = cv.clamp(0, H - 1).to(torch.int64) * W + cu.clamp(0, W - 1).to(torch.int64)
+            val = fk[idx].float()
+            c = ins & (val != 0)
+            vc = val.clamp(-clip, clip)
+            w = torch.where(c, wa * wb, torch.zeros_like(U))
+            num.add_(w * vc); den.add_(w)
+            isn = (nu_ == bool(a)) & (nv_ == bool(b))
+            okn = okn | (isn & c)
+            vn = torch.where(isn & c, vc, vn)
+            del idx, val, c, vc, w, isn, ins
+    return num / den.clamp(min=1e-6), okn, vn
+
