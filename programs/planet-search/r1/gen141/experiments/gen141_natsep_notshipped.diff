+def _natsep(fs_, fex_, fey_, fevx_, fevy_, okn_, s2o_, n0, NPK, NX, blend):
+    """gen 141 (TNO_FSTK_NATSEP): selection for a native pool = gen139 pool (first n0) + natwide extras.  The blend k is
+    computed on the gen139 pool alone (as in gen139), its best NPK are kept, and extras whose (blended) score beats the
+    NPK-th kept score (any valid extra if fewer than NPK were kept) take up to NX extra slots.  Returns the blended arrays,
+    the kept indices (into the pool), the number of extras kept and the threshold."""
+    fs_ = np.array(fs_, float); fex_ = np.array(fex_, float); fey_ = np.array(fey_, float)
+    fevx_ = np.array(fevx_, float); fevy_ = np.array(fevy_, float); okn_ = np.array(okn_, bool)
+    s2o_ = np.asarray(s2o_, float)
+    fsn_ = np.where(okn_, fs_, -1e9)
+    if blend:
+        a0 = fsn_[:n0][okn_[:n0]]
+        if len(a0) == 0:
+            return None
+        kk_ = float(np.median(np.sort(a0)[::-1][:NPK])) / max(float(np.median(np.sort(s2o_[:n0])[::-1][:NPK])), 1e-6)
+        kk_ = kk_ if (np.isfinite(kk_) and 0.5 < kk_ < 3.0) else 1.0
+        use2_ = (kk_ * s2o_ > fsn_) & (s2o_ > -1e8)
+        fs_ = np.where(use2_, kk_ * s2o_, fs_); okn_ = okn_ | use2_
+        fex_ = np.where(use2_, 0.0, fex_); fey_ = np.where(use2_, 0.0, fey_)
+        fevx_ = np.where(use2_, 0.0, fevx_); fevy_ = np.where(use2_, 0.0, fevy_)
+        fsn_ = np.where(okn_, fs_, -1e9)
+    oa = np.argsort(-fsn_[:n0])[:NPK]
+    oa = oa[okn_[oa]]
+    thr = float(fsn_[oa[-1]]) if len(oa) >= NPK else -1e8
+    ox = np.zeros(0, np.int64)
+    if NX > 0 and len(fsn_) > n0:
+        sx = fsn_[n0:]
+        ox = np.argsort(-sx)[:NX]
+        ox = ox[(sx[ox] > thr) & okn_[n0:][ox]] + n0
+    o3 = np.concatenate([oa.astype(np.int64), ox.astype(np.int64)])
+    if len(o3) == 0:
+        return None
+    return fs_, fex_, fey_, fevx_, fevy_, o3, len(ox), thr
 
 
