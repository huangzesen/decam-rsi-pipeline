+import sys, os, pickle, json, time, math
+sys.path.insert(0, "$RSI_SANDBOX/r1/gen109/tmp/armT/submission/linker")
+import numpy as np
+import orbit
+orbit.T0 = time.time()
+import trk
+L = pickle.load(open(sys.argv[1], "rb"))
+T = json.load(open(sys.argv[2])) if len(sys.argv) > 2 and sys.argv[2] != "-" else None
+t0 = time.time()
+out = trk.run_trk(L, 60)
+print("time", time.time() - t0, "n", len(out))
+et, eobs, enight, done = L["et"], L["eobs"], L["enight"], L["done"]
+if T:
+    tb = [orbit.predict_dirs(np.array(b["state"]), b["epoch_mjd"], et[done], eobs[done]) for b in T["bodies"]]
+    hits = []
