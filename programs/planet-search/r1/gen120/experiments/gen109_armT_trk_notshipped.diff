+"""gen109 armT: same-night tracklet seeds for weight-4 bodies bright on only 1-2 nights (TNO_TRK).
+
+A detection (S/N >= TRK_SN) with a partner (S/N >= TRK_SN2) in another exposure of the same night, within the
+distance a TNO can move between them, is a tracklet: a real, non-static point source (noise peaks and cosmics do not
+repeat at the same place; stationary sources are already removed by the linker's static mask).  Two tracklets on two
+different nights, under the linker's linearised model at inverse distance gamma, fix (alpha, alpha-dot); the
+near-circular prior (|alpha-dot| ~ sqrt(GM gamma^3), prograde within TRK_ANG of ecliptic east) leaves only a narrow
+gamma range, so each tracklet pair gives about one orbit hypothesis.  It is tested by forced photometry on all other
+nights' exposures (clipped summed S/N + per-night sign count).  Survivors get a two-body state and a low p.
+"""
+import math, os, time
+import numpy as np
+from scipy.spatial import cKDTree
+from orbit import GM, C_AU, ARC, log, predict_dirs, fit_orbit
+
+TRK_SN = float(os.environ.get("TNO_TRK_SN", "5.0"))
+TRK_SN2 = float(os.environ.get("TNO_TRK_SN2", "4.0"))
+TRK_RATE = float(os.environ.get("TNO_TRK_RATE", "5.0"))     # arcsec/hour max within-night motion
+TRK_R0 = float(os.environ.get("TNO_TRK_R0", "0.6"))         # arcsec position tolerance of a tracklet partner
+TRK_CLO = float(os.environ.get("TNO_TRK_CLO", "0.85"))
+TRK_CHI = float(os.environ.get("TNO_TRK_CHI", "1.12"))
+TRK_ANG = float(os.environ.get("TNO_TRK_ANG", "45"))
+TRK_ZT = float(os.environ.get("TNO_TRK_ZT", "2.0"))
+TRK_P0 = float(os.environ.get("TNO_TRK_P0", "0.35"))
+TRK_ZC = float(os.environ.get("TNO_TRK_ZC", "4.0"))
+TRK_SMAX = float(os.environ.get("TNO_TRK_SMAX", "30"))      # tracklet S/N cap (very bright = variable/static residue)
+TRK_STAT = float(os.environ.get("TNO_TRK_STAT", "1.0"))     # >0: subtract the other nights' median at the same sky spot; mask if > this
+TRK_MZ = os.environ.get("TNO_TRK_MZ", "1") == "1"
+TRK_S1 = float(os.environ.get("TNO_TRK_S1", "0"))           # >0: single-exposure nights give S/N >= S1 pseudo-tracklets
+
+
+DBG = set()
+
+
+def tracklets(L):
+    gi, u, sn, E, et, enight = L["gi"], L["u"], L["sn"], L["E"], L["et"], L["enight"]
+    if TRK_MZ:
+        # uncalibrated exposures (empty magzero: bad WCS in the dev data) give no tracklet seeds
+        gi = gi[np.isfinite(L["emz"][E[gi]])]
+    reps = []
+    for nn in np.unique(enight[E[gi]]):
+        m = gi[(enight[E[gi]] == nn) & (sn[gi] >= TRK_SN2) & (sn[gi] < 200)]
+        ex = np.unique(E[m])
+        if len(ex) < 2:
+            if TRK_S1 > 0 and len(ex) == 1:
+                for x in m[(sn[m] >= TRK_S1) & (sn[m] <= TRK_SMAX)]:
+                    reps.append((x, x, int(nn), float(sn[x]), 0))
+            continue
+        ex = ex[np.argsort(et[ex])]
+        ix = {e: m[E[m] == e] for e in ex}
+        tr = {e: cKDTree(u[ix[e]]) for e in ex}
+        cand = []
+        for a in range(len(ex)):
+            for b in range(a + 1, min(a + 4, len(ex))):
+                dth = abs(et[ex[b]] - et[ex[a]]) * 24
+                if dth > 4.0:
+                    break
+                r = (TRK_RATE * dth + TRK_R0) * ARC
+                sd = tr[ex[a]].sparse_distance_matrix(tr[ex[b]], r, output_type="ndarray")
+                if len(sd) == 0:
+                    continue
+                i = ix[ex[a]][sd["i"]]; j = ix[ex[b]][sd["j"]]
+                ok = np.maximum(sn[i], sn[j]) >= TRK_SN
+                for x, y in zip(i[ok], j[ok]):
+                    cand.append(((sn[x] + sn[y]) / math.sqrt(2), x, y))
+        cand.sort(key=lambda c: -c[0])
+        used = set()
+        for s, x, y in cand:
+            if x in used or y in used or s > TRK_SMAX:
+                continue
+            used.add(x); used.add(y)
+            reps.append((x if sn[x] >= sn[y] else y, x if sn[x] < sn[y] else y, int(nn), float(s), 1))
+    return reps
+
+
+def run_trk(L, tmax):
+    t1 = time.time()
+    FP, F, grid = L["FP"], L["F"], L["grid"]
+    et, eobs, enight, E, D = L["et"], L["eobs"], L["enight"], L["E"], L["D"]
+    u, sn, t_ref, done, core = L["u"], L["sn"], L["t_ref"], L["done"], L["core"]
+    ee = L["ee"]
+    mexps = np.array([e for e in done if FP.has(e)])
+    if len(np.unique(enight[mexps])) < 3:
+        return []
+    reps = tracklets(L)
+    if len(reps) < 2:
+        return []
+    if TRK_STAT:
+        # tracklet on a faint static source (galaxy/star below the static mask): positive at the same sky spot on
+        # the other nights' exposures
+        ua = u[[r[0] for r in reps]]
+        nr = np.array([r[2] for r in reps])
+        ref = np.full((len(mexps), len(reps)), np.nan)
+        for k2, e2 in enumerate(mexps):
+            ref[k2] = FP.sample(e2, ua)
+            ref[k2, nr == enight[e2]] = np.nan
+        with np.errstate(all="ignore"):
+            med = np.nan_to_num(np.nanmedian(ref, axis=0), nan=0.0)
+        n0 = len(reps)
+        reps = [r for r, m_ in zip(reps, med) if m_ <= TRK_STAT]
+        log(f"trk: static test drops {n0 - len(reps)} of {n0} tracklets")
+        if len(reps) < 2:
+            return []
+    seeds = np.array([r[0] for r in reps]); part = np.array([r[1] for r in reps])
+    ns = np.array([r[2] for r in reps]); tsn = np.array([r[3] for r in reps]); real = np.array([r[4] for r in reps])
+    log(f"trk: {len(reps)} tracklets on {len(np.unique(ns))} nights in {time.time() - t1:.1f}s "
+        f"(per night {dict(zip(*np.unique(ns, return_counts=True)))})")
+    us = u[seeds] @ F.T
+    theta = us[:, :2] / us[:, 2:3]
+    obs_f = eobs @ F.T
+    ts = et[E[seeds]] - t_ref
+    os_ = obs_f[E[seeds]]
+    un = np.unique(ns)
+    mn = enight[mexps]
+    te = et[mexps] - t_ref
+    cosang = math.cos(math.radians(TRK_ANG))
+    hyp = {}
+    nh = 0
+    for g in grid:
+        if time.time() - t1 > tmax:
+            log("trk: gamma loop out of time")
+            break
+        tp = ts - 1.0 / (C_AU * g)
+        k_ = 0.5 * GM * g ** 3
+        f = 1.0 - k_ * tp * tp - g * os_[:, 2]
+        phi = theta * f[:, None] + g * os_[:, :2]
+        uu = 1.0 - k_ * tp * tp
+        npara = math.sqrt(2 * GM * g ** 3)
+        ncirc = math.sqrt(GM * g ** 3)
+        idx_n = [np.flatnonzero(ns == n_) for n_ in un]
+        trees = [cKDTree(phi[ix]) for ix in idx_n]
+        for p in range(len(un)):
+            for q in range(p + 1, len(un)):
+                dt = un[q] - un[p]
+                sd = trees[p].sparse_distance_matrix(trees[q], TRK_CHI * ncirc * (dt + 0.5) + 2 * ARC, output_type="ndarray")
+                if len(sd) == 0:
+                    continue
+                i = idx_n[p][sd["i"]]; j = idx_n[q][sd["j"]]
+                Dd = uu[i] * tp[j] - uu[j] * tp[i]
+                al = (phi[i] * tp[j, None] - phi[j] * tp[i, None]) / Dd[:, None]
+                ad = (uu[i, None] * phi[j] - uu[j, None] * phi[i]) / Dd[:, None]
+                adn = np.hypot(ad[:, 0], ad[:, 1])
+                rr = adn / ncirc
+                cs = (ad @ ee) / np.maximum(adn, 1e-30)
+                if DBG:
+                    for a, b, r_, c_, al_ in zip(i, j, rr, cs, al):
+                        if seeds[a] in DBG and seeds[b] in DBG:
+                            print("DBG pair", 1 / g, round(r_, 3), round(c_, 3), np.hypot(*al_) / (core + 2 * g))
+                ok = (real[i] + real[j] >= 1) & (np.hypot(al[:, 0], al[:, 1]) <= core + 2 * g) & (rr >= TRK_CLO) & (rr <= TRK_CHI) & (cs >= cosang)
+                for a, b, c, d, r_ in zip(i[ok], j[ok], al[ok], ad[ok], rr[ok]):
+                    nh += 1
+                    # every gamma of the near-circular range is scored (a 2-night pair does not fix gamma)
+                    hyp[(int(a), int(b), float(g))] = (g, c.copy(), d.copy(), float(r_))
+    log(f"trk: {nh} (pair, gamma) hypotheses, {len(hyp)} tracklet pairs in {time.time() - t1:.1f}s")
+    if not hyp:
+        return []
+    keys = list(hyp.keys())
+    G = np.array([hyp[k][0] for k in keys]); AL = np.array([hyp[k][1] for k in keys]); AD = np.array([hyp[k][2] for k in keys])
+    NA = ns[[k[0] for k in keys]]; NB = ns[[k[1] for k in keys]]
+    # forced photometry on all mapped exposures (linear model predictions)
+    N = len(keys)
+    S = np.zeros(N); Nn = np.zeros(N)
+    NS = {}
+    for k, e in enumerate(mexps):
+        if time.time() - t1 > tmax * 1.5:
+            break
+        tpe = te[k] - 1.0 / (C_AU * G)
+        kk = 0.5 * GM * G ** 3
+        ph = AL * (1 - kk * tpe * tpe)[:, None] + AD * tpe[:, None]
+        tt = (ph - G[:, None] * obs_f[e, :2]) / (1.0 - kk * tpe * tpe - G * obs_f[e, 2])[:, None]
+        vv = np.c_[tt, np.ones(N)] @ F
+        vv /= np.linalg.norm(vv, axis=1)[:, None]
+        oth = (NA != mn[k]) & (NB != mn[k])
+        s = np.full(N, np.nan)
+        s[oth] = FP.sample(e, vv[oth])
+        v = np.isfinite(s) & oth
+        if TRK_STAT and v.any():
+            # static-source test: the same sky position on the other nights' exposures (a body is elsewhere there)
+            w = np.flatnonzero(v)
+            ref = np.full((len(mexps), len(w)), np.nan)
+            for k2, e2 in enumerate(mexps):
+                if mn[k2] != mn[k]:
+                    ref[k2] = FP.sample(e2, vv[w])
+            with np.errstate(all="ignore"):
+                med = np.nanmedian(ref, axis=0)
+            med = np.nan_to_num(med, nan=0.0)
+            s[w] = s[w] - med
+            v[w[med > TRK_STAT]] = False
+        sc = np.where(v, np.clip(np.nan_to_num(s), -3.0, 4.0), 0.0)
+        S += sc; Nn += v
+        key = int(mn[k])
+        if key not in NS:
+            NS[key] = [np.zeros(N), np.zeros(N)]
+        NS[key][0] += sc; NS[key][1] += v
+    z = S / np.sqrt(np.maximum(Nn, 1.0))
+    npos = np.zeros(N, int); nneg = np.zeros(N, int); nwith = np.zeros(N, int)
+    for a_, b_ in NS.values():
+        zn = a_ / np.sqrt(np.maximum(b_, 1.0))
+        has = b_ > 0
+        nwith += has; npos += has & (zn > 1.0); nneg += has & (zn < -1.0)
+    if DBG:
+        for h, k in enumerate(keys):
+            if seeds[k[0]] in DBG and seeds[k[1]] in DBG:
+                print("DBG score", 1 / G[h], z[h], npos[h], nneg[h], nwith[h], Nn[h])
+    sel = np.flatnonzero((z >= TRK_ZT) & (npos >= 1) & (npos > nneg))
+    log(f"trk: {len(sel)} of {N} pass z>={TRK_ZT}; z quantiles {np.round(np.percentile(z, [50, 90, 99, 99.9]), 2)}")
+    order = sel[np.argsort(-(z[sel] + 0.5 * npos[sel]))]
+    log(f"trk: {len({keys[h][:2] for h in sel})} tracklet pairs pass")
+    out = []
+    kept_al = []
+    used = set()
+    REJ = {}
+    for h in order:
+        if len(out) >= int(os.environ.get("TNO_TRK_MAX", "60")) or time.time() - t1 > tmax * 2:
+            break
+        a, b = keys[h][:2]
+        g, al, ad = G[h], AL[h], AD[h]
+        if a in used or b in used:
+            continue
+        if kept_al and np.min(np.hypot(*(np.array(kept_al) - al).T)) < 4 * ARC:
+            continue
+        rf = np.array([al[0], al[1], 1.0]) / g
+        vf = np.array([ad[0], ad[1], 0.0]) / g
+        state0 = np.r_[F.T @ rf, F.T @ vf]
+        tpe = te - 1.0 / (C_AU * g); k_ = 0.5 * GM * g ** 3
+        ph = al[None] * (1 - k_ * tpe * tpe)[:, None] + ad[None] * tpe[:, None]
+        tt = (ph - g * obs_f[mexps, :2]) / (1.0 - k_ * tpe * tpe - g * obs_f[mexps, 2])[:, None]
+        vv = np.c_[tt, np.ones(len(tt))] @ F
+        vv /= np.linalg.norm(vv, axis=1)[:, None]
+        sa, sb = seeds[a], seeds[b]; pa, pb = part[a], part[b]
+        tobs = np.r_[et[mexps], et[E[[sa, pa, sb, pb]]]]  # (pa == sa for pseudo-tracklets: harmless repeat)
+        oobs = np.r_[eobs[mexps], eobs[E[[sa, pa, sb, pb]]]]
+        uobs = np.r_[vv, u[[sa, pa, sb, pb]]]
+        try:
+            st, res = fit_orbit(state0, t_ref, tobs, oobs, uobs)
+        except Exception:
+            if DBG and sa in DBG: print("DBG fitx")
+            REJ["fitx"] = REJ.get("fitx", 0) + 1; continue
+        if DBG and sa in DBG and sb in DBG:
+            print("DBG fit", np.round(res, 2), np.linalg.norm(st[:3]))
+        if not np.all(np.isfinite(st)) or res[-4:].max() > 1.0:
+            REJ["fit"] = REJ.get("fit", 0) + 1; continue
+        r = float(np.linalg.norm(st[:3]))
+        if not (25.5 < r < 300) or np.dot(st[3:], st[3:]) / 2 - GM / r >= 0:
+            REJ["r"] = REJ.get("r", 0) + 1; continue
+        kept_al.append(al); used.add(a); used.add(b)
+        mz = L["emz"]
+        mags = [mz[E[x]] - 2.5 * math.log10(D[x, 4]) for x in (sa, sb) if np.isfinite(mz[E[x]]) and D[x, 4] > 0]
+        out.append(dict(state=st, z=float(z[h]), npos=int(npos[h]), nneg=int(nneg[h]), nwith=int(nwith[h]),
+                        tsn=(float(tsn[a]), float(tsn[b])), r=r, mag=float(np.median(mags)) if mags else None))
+    log("trk rejects", REJ)
+    log(f"trk: {len(out)} candidates in {time.time() - t1:.1f}s; top {[(round(c['z'], 1), c['npos'], c['nwith']) for c in out[:10]]}")
+    return out
+
+
+def p_trk(c):
+    zz = c["z"] + 0.3 * (c["npos"] - 1) - 0.3 * c["nneg"]
+    return float(TRK_P0 / (1 + math.exp(-1.5 * (zz - TRK_ZC))))
