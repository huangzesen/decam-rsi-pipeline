+        pd = orbit.predict_dirs(c["state"], L["t_ref"], et[done], eobs[done])
+        for j, P in enumerate(tb):
+            d = np.arccos(np.clip(np.sum(P * pd, 1), -1, 1)) / orbit.ARC
+            nts = len(np.unique(enight[done][d < 2.0]))
+            if nts >= 3:
+                hits.append((k, j)); print("HIT rank", k, "body", j, T["bodies"][j].get("cls"), "p", round(trk.p_trk(c), 3), c["z"], c["npos"], c["nneg"], c["nwith"], c["tsn"])
+    print("hits", len(hits), "bodies", len({j for _, j in hits}))
+for c in out[:30]:
+    print(round(trk.p_trk(c), 3), round(c["z"], 2), c["npos"], c["nneg"], c["nwith"], np.round(c["tsn"], 1), round(c["r"], 1))
