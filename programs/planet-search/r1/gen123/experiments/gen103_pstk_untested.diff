+    fnt = torch.as_tensor(fn, device=dev)
+    wft = torch.as_tensor(np.asarray(wf, np.float64), dtype=f32, device=dev)
+    obt = torch.as_tensor(np.asarray(obs, np.float64), dtype=f32, device=dev)
+    TFt = torch.as_tensor(TF0, dtype=f32, device=dev)
+    mflat = maps.reshape(-1); cflat = cov.reshape(-1)
