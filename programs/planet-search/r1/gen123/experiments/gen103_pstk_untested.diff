+def pstk_seeds(torch, dev, maps, cov, wf, t, night, obs, TF0, x0, y0, PIX, W, H, deadline, KEEP, log_):
+    """gen 103 (TNO_PSTK): pair-seeded all-exposure stack.  Every pair of low-threshold (z >= PSTK_Z) night co-add
+    peaks on two nights consistent with a bound TNO rate at distance d (d-frame, linear motion) fixes a track; the
+    track is read from EVERY per-exposure map and scored by the weighted, winsorized S/N of the exposures of the
+    OTHER nights only (held-out: the seeding nights were selected and are biased).  No third-night peak needed.
+    Returns rows (score, d, vx, vy, px, py, local frame index, 200) and frames (TD, tref, oref)."""
