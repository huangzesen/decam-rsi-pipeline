+                st = torch.cumsum(c_, 0) - c_
+                ib = lo_[e0:e1].repeat_interleave(c_) + (torch.arange(n_, device=dev) - st.repeat_interleave(c_))
+                dlt = Qbs[ib] - ctr[ia]
