+            bounds = torch.searchsorted(cs, torch.linspace(0, tot, nch + 1, device=dev)[1:-1].to(cs.dtype).contiguous())
+            edges = [0] + [int(x) + 1 for x in bounds.tolist()] + [len(Qa)]
+            for e0, e1 in zip(edges[:-1], edges[1:]):
+                if e1 <= e0:
+                    continue
+                c_ = cnt[e0:e1]
+                n_ = int(c_.sum().item())
+                if n_ == 0:
+                    continue
