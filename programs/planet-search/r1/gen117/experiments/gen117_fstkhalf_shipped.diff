+def _half_merge(rows_out, idx0, new_, cap, SP, dv, stat):
+    """gen 117: merge half-step pass rows of one distance into pass 0's rows (indices idx0 in rows_out).  A new row
+    within 1.5 search px and 1.5 velocity steps of a pass-0 row replaces it if better, else is dropped; the union is
+    capped to the best `cap` rows (dropped pass-0 rows are removed from rows_out)."""
+    if not new_:
+        return rows_out
+    old = [rows_out[i] for i in idx0]
+    if old:
+        op = np.array([[r[4], r[5], r[2], r[3]] for r in old])
+    keep_old = list(old); add = []
+    for r in new_:
+        if old:
+            dd = np.hypot(op[:, 0] - r[4], op[:, 1] - r[5]) / SP
+            dvv = np.hypot(op[:, 2] - r[2], op[:, 3] - r[3]) / (SP * dv)
+            m = np.nonzero((dd <= 1.5) & (dvv <= 1.5))[0]
+            if len(m):
+                j = int(m[np.argmax([keep_old[i][0] for i in m])])
+                if r[0] > keep_old[j][0]:
+                    keep_old[j] = r; stat[0] += 1
+                else:
+                    stat[2] += 1
+                continue
+        add.append(r)
+    uni = sorted(keep_old + add, key=lambda r: -r[0])[:cap]
+    stat[1] += sum(1 for r in add if r in uni)
+    stat[2] += sum(1 for r in add if r not in uni)
+    # in place (other distances' index lists stay valid); surplus slots become None (filtered at the end)
+    for k, i in enumerate(idx0):
+        rows_out[i] = uni[k] if k < len(uni) else None
+    rows_out.extend(uni[len(idx0):])
+    return rows_out
 
 
