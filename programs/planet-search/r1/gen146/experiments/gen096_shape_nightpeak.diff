+            zhi = (0.9 * zc_) if zc_ is not None else 1e9
+            br = (sc_ >= 6.0) & (sc_ < zhi) & (Sm.sum(1) >= K_ * K_)
+            nb = int(br.sum())
+            r2 = (dyo.float() ** 2 + dxo.float() ** 2)
+            sig = 0.8
+            if nb >= 30:
