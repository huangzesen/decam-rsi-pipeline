+            def chi2(Sv_, Sm_):
+                TT = (Sm_ * T_[None] ** 2).sum(1).clamp(min=1e-6)
+                A = (Sm_ * Sv_ * T_[None]).sum(1) / TT
+                res = (Sv_ - A[:, None] * T_[None]) * Sm_
