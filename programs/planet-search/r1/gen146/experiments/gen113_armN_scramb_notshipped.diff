+    # gen 113 (arm N, TNO_SCRAMB, default 0 = off): time-scrambled null for kind-3 tracks.  The same refined track is
+    # re-sampled with the night order permuted (exposure i of night a is read at the path position predicted for night
+    # pi(a)), so the samples lie on the same pixel path but do not follow the body.  SCRAMB > 0: the clipped stack used
+    # for the kind-3 z becomes scq - SCRAMB * mean(scrambled clipped stacks) (null rows transformed the same way).
+    SCRAMB = float(os.environ.get("TNO_SCRAMB", "0") or 0)
