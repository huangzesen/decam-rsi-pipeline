+            c = cov.reshape(-1)[lt_].cpu().numpy().reshape(lin.shape) & okk
+            v = np.where(c, v, 0)
+            out_.append(total(np.minimum(v, clip), c))
+        o_ = np.stack(out_, 1)
+        return o_.mean(1), o_.std(1), o_.max(1)
+    scr_cache_ = {}
