+        out_ = []
+        for src_ in scr_src_:
+            ix = ix0[:, src_]; iy = iy0[:, src_]
+            okk = (ix >= 0) & (ix < W) & (iy >= 0) & (iy < H)
+            lin = np.where(okk, iy * W + ix, 0) + np.arange(N)[None] * (H * W)
+            lt_ = torch.from_numpy(lin.ravel()).to(dev)
