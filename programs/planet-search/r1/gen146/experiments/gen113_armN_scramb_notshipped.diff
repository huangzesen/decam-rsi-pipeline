+    scr_src_ = []
+    try:
+        if (SCRAMB > 0 or SCR_LOG) and len(nights_idx) >= 3:
+            rg_ = np.random.default_rng(113)
+            nn__ = len(nights_idx)
+            for _ in range(SCR_NP):
+                while True:
+                    pi_ = rg_.permutation(nn__)
